{
    "name": "zbmowrey/weighted-levenshtein",
    "description": "Weighted Levenshtein, Optimal String Alignment, and Damerau-Levenshtein distance for PHP 8.4+ — a port of infoscout/weighted-levenshtein.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "levenshtein",
        "damerau",
        "damerau-levenshtein",
        "osa",
        "optimal-string-alignment",
        "edit-distance",
        "fuzzy-matching",
        "string-similarity"
    ],
    "authors": [
        {
            "name": "Zach Mowrey",
            "email": "zbmowrey@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": {
            "Zbmowrey\\WeightedLevenshtein\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Zbmowrey\\WeightedLevenshtein\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": [
            "@test",
            "@stan",
            "@cs-check"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
